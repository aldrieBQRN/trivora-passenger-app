{
  "expo": {
    "name": "Trivora Commuter",
    "slug": "trivora-passenger-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.gov.trivora.passenger",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Trivora uses your location to set your pick-up point and match you with nearby tricycles."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "ph.gov.trivora.passenger",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trivora uses your location to set your pick-up point and match you with nearby tricycles."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#182B62"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trivora needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Trivora needs camera access so you can take a profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Trivora uses the camera to scan the QR code on a tricycle so you can join its ride.",
          "recordAudioAndroid": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "extraProguardRules": "-keep class org.maplibre.** { *; }\n-keep class com.facebook.react.** { *; }\n-keep class expo.modules.notifications.** { *; }\n-keepclasseswithmembernames class * { native <methods>; }",
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "packagingOptions": {
              "exclude": [
                "/lib/x86/**",
                "/lib/x86_64/**"
              ]
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Plus Jakarta Sans",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
              "node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
              "node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
              "node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf"
            ]
          }
        }
      ],
      "expo-asset"
    ],
    "updates": {
      "url": "https://u.expo.dev/40f9df69-61f4-42ea-9324-7105370d0c13"
    },
    "runtimeVersion": "1.1.0",
    "extra": {
      "eas": {
        "projectId": "40f9df69-61f4-42ea-9324-7105370d0c13"
      }
    },
    "owner": "aldriebqrn-team"
  }
}
